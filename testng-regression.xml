<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Regression Test Suite — full test run for nightly CI.
  Runs tests in parallel (4 threads) for speed.
  To run: mvn test -DsuiteXmlFile=testng-regression.xml
-->
<suite name="NHIMS Regression Suite" parallel="methods" thread-count="4" verbose="1">

    <listeners>
        <listener class-name="com.nhims.listeners.TestListener"/>
    </listeners>

    <test name="Regression Tests">
        <classes>
            <class name="com.nhims.scripts.RegisterTest"/>
            <class name="com.nhims.scripts.LoginTest"/>
            <class name="com.nhims.scripts.ContactUsTest"/>
            <class name="com.nhims.scripts.TestCasesTest"/>
            <class name="com.nhims.scripts.ProductsTest"/>
            <class name="com.nhims.scripts.SubscriptionTest"/>
            <class name="com.nhims.scripts.CartTest"/>
        </classes>
    </test>

</suite>
