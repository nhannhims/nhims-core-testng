<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Smoke Test Suite — runs quickly before each deploy.
  Uses sequential execution to minimise resource usage.
  To run: mvn test -DsuiteXmlFile=testng-smoke.xml
-->
<suite name="NHIMS Smoke Suite" parallel="none" verbose="1">

    <listeners>
        <listener class-name="com.nhims.listeners.TestListener"/>
    </listeners>

    <test name="Smoke Tests">
        <classes>
            <class name="com.nhims.scripts.TestExample"/>
        </classes>
    </test>

</suite>
